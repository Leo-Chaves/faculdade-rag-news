# Variaveis de ambiente - NAO commite este arquivo!
# Copie para .env e preencha com seus valores reais.

# Chave da API do OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-XXXXXXXXXXXXXXXXXXXXXXXX

# Modelos gratuitos da NVIDIA (Nemotron) no OpenRouter
# Opções de chat (gratuitos): nvidia/nemotron-3.5-super-vl:free, nvidia/nemotron-3-nano-30b-a3b:free, nvidia/nemotron-3.5-lightning:free
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
# Opções de embedding (gratuitos): nvidia/llama-nemotron-embed-vl-1b-v2:free
OPENROUTER_EMBEDDING_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2:free

# Conexao com Supabase - use variaveis SEPARADAS para evitar
# problemas com caracteres especiais na senha (acentos, @, #, etc.)

# Usuario do banco (normalmente "postgres" no Supabase)
DB_USER=postgres

# Sua senha do Supabase (pode ter qualquer caractere, sem aspas)
DB_PASSWORD=suaSenhaAqui123

# Host do projeto Supabase: Settings > Database > Host
# Exemplo: db.abcdefghijklm.supabase.co
DB_HOST=db.XXXXXXXXXX.supabase.co

# Porta (5432 por padrao no Supabase)
DB_PORT=5432

# Nome do banco (normalmente "postgres")
DB_NAME=postgres

# Supabase Dashboard > Connect > Publishable key (sb_publishable_...).
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# Origens permitidas para o frontend, separadas por vírgula.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://ragnewsbbc.netlify.app

# Opcional. Habilita a rota /reset apenas com o cabeçalho X-Admin-Key.
RAG_ADMIN_KEY=
